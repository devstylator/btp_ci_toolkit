<mvc:View
  controllerName="btp.toolkit.versioncomparator.controller.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:table="sap.ui.table"
  xmlns:rowmodes="sap.ui.table.rowmodes"
  height="100%">
  <NavContainer id="nav" height="100%">
    <!-- list: DEV packages -->
    <f:DynamicPage id="listPage" headerExpanded="true" toggleHeaderOnTitleClick="true" fitContent="true" busy="{view>/busy}" busyIndicatorDelay="0">
      <f:title>
        <f:DynamicPageTitle>
          <f:heading><Title text="{i18n>appTitle}"/></f:heading>
          <f:snappedContent><Text text="{= ${view>/query} ? ${i18n>colName} + ': ' + ${view>/query} : ''}"/></f:snappedContent>
        </f:DynamicPageTitle>
      </f:title>
      <f:header>
        <f:DynamicPageHeader pinnable="true">
          <VBox renderType="Bare">
            <Label text="{i18n>colName}" labelFor="packageFilter"/>
            <SearchField
              id="packageFilter"
              width="24rem"
              value="{view>/query}"
              placeholder="{i18n>filterPackages}"
              liveChange=".onFilterPackages"
              search=".onFilterPackages"/>
            <Text text="{i18n>packageHint}" class="sapUiTinyMarginTop sapThemeLightText"/>
          </VBox>
        </f:DynamicPageHeader>
      </f:header>
      <f:content>
        <VBox renderType="Bare" height="100%">
          <MessageStrip
            text="{view>/error}"
            type="Error"
            showIcon="true"
            visible="{= !!${view>/error}}"
            class="sapUiSmallMarginBottom"/>
          <table:Table
            id="packageTable"
            rows="{view>/packages}"
            selectionMode="None"
            rowActionCount="1"
            alternateRowColors="true"
            cellClick=".onCellClick"
            rowsUpdated=".onRowsUpdated"
            noData="{i18n>noPackages}">
            <table:layoutData><FlexItemData growFactor="1" baseSize="0%"/></table:layoutData>
            <table:rowMode><rowmodes:Auto minRowCount="5"/></table:rowMode>
            <table:extension>
              <OverflowToolbar style="Clear">
                <Title text="{view>/countText}" level="H2"/>
                <ToolbarSpacer/>
                <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>reload}" press=".onReload"/>
              </OverflowToolbar>
            </table:extension>
            <table:rowActionTemplate>
              <table:RowAction>
                <table:RowActionItem type="Navigation" press=".onRowAction"/>
              </table:RowAction>
            </table:rowActionTemplate>
            <table:columns>
              <table:Column width="22rem" sortProperty="name">
                <Label text="{i18n>colName}"/>
                <table:template><Text text="{view>name}" wrapping="false" tooltip="{view>name}"/></table:template>
              </table:Column>
              <table:Column width="18rem" sortProperty="id">
                <Label text="{i18n>colId}"/>
                <table:template><Text text="{view>id}" wrapping="false" tooltip="{view>id}"/></table:template>
              </table:Column>
              <table:Column minWidth="200" sortProperty="description">
                <Label text="{i18n>colDescription}"/>
                <table:template><Text text="{view>description}" wrapping="false" tooltip="{view>description}"/></table:template>
              </table:Column>
            </table:columns>
          </table:Table>
        </VBox>
      </f:content>
    </f:DynamicPage>

    <!-- detail: comparison of one package -->
    <f:DynamicPage id="detailPage" headerExpanded="true" toggleHeaderOnTitleClick="true" busy="{view>/detailBusy}" busyIndicatorDelay="0">
      <f:title>
        <f:DynamicPageTitle>
          <f:heading>
            <HBox alignItems="Center" renderType="Bare">
              <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>back}" press=".onBack" class="sapUiTinyMarginEnd"/>
              <Title text="{view>/package/name}" wrapping="true"/>
            </HBox>
          </f:heading>
          <f:snappedContent><Text text="{view>/package/id}"/></f:snappedContent>
          <f:actions>
            <Button icon="sap-icon://refresh" text="{i18n>recompare}" type="Transparent" press=".onRecompare"/>
          </f:actions>
        </f:DynamicPageTitle>
      </f:title>
      <f:header>
        <f:DynamicPageHeader pinnable="true">
          <FlexBox wrap="Wrap" renderType="Bare">
            <VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom" renderType="Bare">
              <ObjectAttribute title="{i18n>packageId}" text="{view>/package/id}"/>
              <ObjectAttribute title="{i18n>description}" text="{= ${view>/package/description} || '-'}"/>
            </VBox>
            <VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom" renderType="Bare" visible="{= !!${view>/hasResult}}">
              <ObjectStatus
                title="{i18n>inDev}"
                text="{= ${view>/package/inDev} ? ${i18n>present} : ${i18n>missing}}"
                state="{= ${view>/package/inDev} ? 'Success' : 'Error'}"/>
              <ObjectStatus
                title="{i18n>inProd}"
                text="{= ${view>/package/inProd} ? ${i18n>present} : ${i18n>missing}}"
                state="{= ${view>/package/inProd} ? 'Success' : 'Error'}"/>
            </VBox>
            <HBox wrap="Wrap" alignItems="Start" items="{view>/tags}" renderType="Bare">
              <ObjectStatus class="sapUiSmallMarginEnd" state="{view>state}" text="{view>text}" inverted="true"/>
            </HBox>
          </FlexBox>
        </f:DynamicPageHeader>
      </f:header>
      <f:content>
        <VBox renderType="Bare">
          <MessageStrip
            text="{view>/detailError}"
            type="Error"
            showIcon="true"
            visible="{= !!${view>/detailError}}"
            class="sapUiSmallMarginBottom"/>
          <IconTabBar
            id="tabs"
            expandable="false"
            applyContentPadding="false"
            visible="{view>/hasResult}"
            selectedKey="{view>/tab}">
            <items>
              <IconTabFilter key="result" text="{i18n>tabResult}" count="{view>/summary/total}" icon="sap-icon://compare">
                <Table id="resultTable" items="{view>/rows}" growing="true" growingThreshold="100" noDataText="{i18n>noRows}" updateFinished=".onResultUpdated">
                  <headerToolbar>
                    <OverflowToolbar>
                      <Title text="{view>/artifactCountText}" level="H2"/>
                      <ToolbarSpacer/>
                      <SearchField width="18rem" value="{view>/resultQuery}" placeholder="{i18n>filterResults}" liveChange=".onFilterResults" search=".onFilterResults"/>
                      <Label text="{i18n>onlyDifferences}"/>
                      <Switch state="{view>/onlyDifferences}" change=".onFilterResults"/>
                    </OverflowToolbar>
                  </headerToolbar>
                  <columns>
                    <Column width="10rem"><Text text="{i18n>colType}"/></Column>
                    <Column><Text text="{i18n>colArtifact}"/></Column>
                    <Column width="9rem" hAlign="End"><Text text="{i18n>colDev}"/></Column>
                    <Column width="9rem" hAlign="End"><Text text="{i18n>colProd}"/></Column>
                    <Column width="12rem"><Text text="{i18n>colStatus}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{path: 'view>artifactType', formatter: '.formatter.typeText'}"/>
                        <ObjectIdentifier title="{view>artifactId}" text="{view>artifactName}"/>
                        <ObjectNumber number="{path: 'view>devVersion', formatter: '.formatter.version'}" emphasized="false"/>
                        <ObjectNumber number="{path: 'view>prodVersion', formatter: '.formatter.version'}" emphasized="false"/>
                        <ObjectStatus
                          text="{path: 'view>status', formatter: '.formatter.statusText'}"
                          state="{path: 'view>status', formatter: '.formatter.statusState'}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>

              <IconTabFilter key="log" text="{i18n>tabLog}" count="{view>/logCount}" icon="sap-icon://list">
                <Table items="{view>/log}" noDataText="{i18n>noRows}">
                  <columns>
                    <Column width="7rem"><Text text="{i18n>colTime}"/></Column>
                    <Column width="4rem"><Text text="{i18n>colLevel}"/></Column>
                    <Column><Text text="{i18n>colMessage}"/></Column>
                  </columns>
                  <items>
                    <ColumnListItem>
                      <cells>
                        <Text text="{path: 'view>timestamp', formatter: '.formatter.time'}"/>
                        <core:Icon
                          src="{path: 'view>level', formatter: '.formatter.levelIcon'}"
                          color="{path: 'view>level', formatter: '.formatter.levelColor'}"
                          tooltip="{view>level}"/>
                        <Text text="{view>message}"/>
                      </cells>
                    </ColumnListItem>
                  </items>
                </Table>
              </IconTabFilter>
            </items>
          </IconTabBar>
        </VBox>
      </f:content>
    </f:DynamicPage>
  </NavContainer>
</mvc:View>
