{
  "_version": "1.65.0",
  "sap.app": {
    "id": "btp.toolkit.search",
    "type": "application",
    "title": "{{appTitle}}",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "main": {
        "uri": "/odata/v4/search/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "btp.toolkit.search.view.Main",
      "type": "XML",
      "async": true,
      "id": "main"
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.ui.layout": {}, "sap.f": {} }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "btp.toolkit.search.i18n.i18n" }
      }
    },
    "resources": { "css": [{ "uri": "css/style.css" }] },
    "contentDensities": { "compact": true, "cozy": true }
  }
}
