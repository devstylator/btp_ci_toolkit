{
  "xsappname": "btp-ci-toolkit",
  "tenant-mode": "dedicated",
  "scopes": [
    { "name": "$XSAPPNAME.Viewer", "description": "Run CPI tools (e.g. version comparison)" },
    { "name": "$XSAPPNAME.Admin", "description": "Edit configuration" }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "CiToolkitViewer",
      "description": "Use CPI tools",
      "scope-references": ["$XSAPPNAME.Viewer"]
    },
    {
      "name": "CiToolkitAdmin",
      "description": "Administer configuration (includes viewer)",
      "scope-references": ["$XSAPPNAME.Admin", "$XSAPPNAME.Viewer"]
    }
  ],
  "role-collections": [
    {
      "name": "CiToolkitViewer",
      "description": "BTP CI Toolkit: use the tools",
      "role-template-references": ["$XSAPPNAME.CiToolkitViewer"]
    },
    {
      "name": "CiToolkitAdmin",
      "description": "BTP CI Toolkit: use the tools and edit the configuration",
      "role-template-references": ["$XSAPPNAME.CiToolkitAdmin"]
    }
  ],
  "authorities-inheritance": false
}
