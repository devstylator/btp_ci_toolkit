{
  "name": "btp_ci_toolkit",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/util": "^4.9.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "deploy:local": "cds deploy --to sqlite:db.sqlite",
    "upgrade:local": "node scripts/upgrade-local.mjs",
    "build": "cds build --production",
    "typecheck": "tsc --noEmit -p .",
    "test": "CDS_TYPESCRIPT=true node --import tsx --test test/*.test.ts"
  },
  "private": true,
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [
                "Admin",
                "Viewer",
                "Developer"
              ]
            },
            "bob": {
              "password": "bob",
              "roles": [
                "Viewer"
              ]
            }
          }
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    },
    "server": {
      "body_parser": {
        "limit": "10mb"
      }
    }
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
